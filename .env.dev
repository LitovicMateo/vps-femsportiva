# ===========================================
# Development Environment Configuration
# ===========================================

ENVIRONMENT=development

# ===========================================
# Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=dev_root_pass_123
MYSQL_DATABASE=wordpress_dev
MYSQL_USER=wp_dev_user
MYSQL_PASSWORD=dev_pass_123

# WordPress Database Connection
WORDPRESS_DB_HOST=database:3306
WORDPRESS_DB_NAME=wordpress_dev
WORDPRESS_DB_USER=wp_dev_user
WORDPRESS_DB_PASSWORD=dev_pass_123

# ===========================================
# WordPress Configuration
# ===========================================
WORDPRESS_URL=http://localhost:8080
WORDPRESS_INTERNAL_URL=http://wordpress
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Authentication Keys & Salts (development only - not secure)
WORDPRESS_AUTH_KEY=dev-auth-key-not-for-production
WORDPRESS_SECURE_AUTH_KEY=dev-secure-auth-key
WORDPRESS_LOGGED_IN_KEY=dev-logged-in-key
WORDPRESS_NONCE_KEY=dev-nonce-key
WORDPRESS_AUTH_SALT=dev-auth-salt
WORDPRESS_SECURE_AUTH_SALT=dev-secure-auth-salt
WORDPRESS_LOGGED_IN_SALT=dev-logged-in-salt
WORDPRESS_NONCE_SALT=dev-nonce-salt

# ===========================================
# Next.js Frontend Configuration
# ===========================================
NEXT_PUBLIC_WORDPRESS_API_URL=http://wordpress/wp-json
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=8080
DOMAIN=localhost
SSL_EMAIL=dev@localhost
