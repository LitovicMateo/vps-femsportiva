# ===========================================
# Production Environment Configuration (Hetzner VPS)
# ===========================================

ENVIRONMENT=production

# ===========================================
# Database Configuration
# ===========================================
# TODO: Generate strong passwords before deployment
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=wordpress_prod
MYSQL_USER=wp_prod_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# WordPress Database Connection
WORDPRESS_DB_HOST=database:3306
WORDPRESS_DB_NAME=wordpress_prod
WORDPRESS_DB_USER=wp_prod_user
WORDPRESS_DB_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

# ===========================================
# WordPress Configuration
# ===========================================
# TODO: Replace with your actual domain
WORDPRESS_URL=https://yourdomain.com
WORDPRESS_INTERNAL_URL=http://wordpress
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Authentication Keys & Salts
# TODO: MUST generate unique keys at https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_SECURE_AUTH_KEY=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_LOGGED_IN_KEY=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_NONCE_KEY=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_AUTH_SALT=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_SECURE_AUTH_SALT=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_LOGGED_IN_SALT=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT
WORDPRESS_NONCE_SALT=GENERATE_UNIQUE_KEY_BEFORE_DEPLOYMENT

# ===========================================
# Next.js Frontend Configuration
# ===========================================
NEXT_PUBLIC_WORDPRESS_API_URL=http://wordpress/wp-json
NEXT_PUBLIC_WORDPRESS_URL=https://yourdomain.com
NEXT_PUBLIC_WORDPRESS_PATH_PREFIX=/wp
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NODE_ENV=production

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=80
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com
