# Environment files — NEVER commit real env files (they contain secrets).
# Only .env.example (placeholders) is tracked; all real .env.* are ignored.
.env
.env.*
!.env.example

# WordPress uploads
data/uploads/*
!data/uploads/.gitkeep

# Database backups
backups/
*.sql
*.sql.gz

# Certbot certificates
certbot/

# Docker volumes
volumes/

# Node
node_modules/
.next/
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
