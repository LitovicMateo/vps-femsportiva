# ===========================================
# Staging Environment Configuration (WSL Ubuntu)
# ===========================================

ENVIRONMENT=staging

# ===========================================
# Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=staging_root_secure_password_change_me
MYSQL_DATABASE=wordpress_staging
MYSQL_USER=wp_staging_user
MYSQL_PASSWORD=staging_secure_password_change_me

# WordPress Database Connection
WORDPRESS_DB_HOST=database:3306
WORDPRESS_DB_NAME=wordpress_staging
WORDPRESS_DB_USER=wp_staging_user
WORDPRESS_DB_PASSWORD=staging_secure_password_change_me

# ===========================================
# WordPress Configuration
# ===========================================
WORDPRESS_URL=http://localhost:8081
WORDPRESS_TABLE_PREFIX=wpstg_

# WordPress Authentication Keys & Salts
# TODO: Generate unique keys at https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=generate-your-unique-phrase-here
WORDPRESS_SECURE_AUTH_KEY=generate-your-unique-phrase-here
WORDPRESS_LOGGED_IN_KEY=generate-your-unique-phrase-here
WORDPRESS_NONCE_KEY=generate-your-unique-phrase-here
WORDPRESS_AUTH_SALT=generate-your-unique-phrase-here
WORDPRESS_SECURE_AUTH_SALT=generate-your-unique-phrase-here
WORDPRESS_LOGGED_IN_SALT=generate-your-unique-phrase-here
WORDPRESS_NONCE_SALT=generate-your-unique-phrase-here

# ===========================================
# Next.js Frontend Configuration
# ===========================================
NEXT_PUBLIC_WORDPRESS_API_URL=http://wordpress/wp-json
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8081
# Use internal Next.js port for SSR (not nginx port)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=production

# ===========================================
# Nginx Configuration
# ===========================================
NGINX_PORT=8081
DOMAIN=localhost
SSL_EMAIL=staging@localhost
