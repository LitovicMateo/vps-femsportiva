# ===========================================
# Environment Configuration Example
# ===========================================
# Copy this file to .env.dev, .env.staging, or .env.prod
# and fill in your specific values for each environment

# Environment Type (development, staging, production)
ENVIRONMENT=development

# ===========================================
# Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress_user
MYSQL_PASSWORD=change_this_password

# WordPress Database Connection
WORDPRESS_DB_HOST=database:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress_user
WORDPRESS_DB_PASSWORD=change_this_password

# ===========================================
# WordPress Configuration
# ===========================================
# WordPress Site URL (where WordPress is installed)
WORDPRESS_URL=http://localhost:8080

# Internal URL for container-to-container requests over the Docker network
WORDPRESS_INTERNAL_URL=http://wordpress

# WordPress Table Prefix (useful for running multiple WP instances in same DB)
WORDPRESS_TABLE_PREFIX=wp_

# WordPress Authentication Keys & Salts
# Generate these at: https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=put-your-unique-phrase-here
WORDPRESS_SECURE_AUTH_KEY=put-your-unique-phrase-here
WORDPRESS_LOGGED_IN_KEY=put-your-unique-phrase-here
WORDPRESS_NONCE_KEY=put-your-unique-phrase-here
WORDPRESS_AUTH_SALT=put-your-unique-phrase-here
WORDPRESS_SECURE_AUTH_SALT=put-your-unique-phrase-here
WORDPRESS_LOGGED_IN_SALT=put-your-unique-phrase-here
WORDPRESS_NONCE_SALT=put-your-unique-phrase-here

# ===========================================
# Next.js Frontend Configuration
# ===========================================
# WordPress API URL (internal Docker network for SSR)
NEXT_PUBLIC_WORDPRESS_API_URL=http://wordpress/wp-json

# Public WordPress URL (for client-side requests if needed)
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8080

# Path prefix WordPress is served under, if any ("/wp" in staging/prod, empty in dev)
NEXT_PUBLIC_WORDPRESS_PATH_PREFIX=

# Public URL of the Next.js frontend (used for canonical URLs, sitemap, OG, feed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js Environment
NODE_ENV=development

# ===========================================
# ISR Revalidation Webhook
# ===========================================
# Shared secret between WordPress (NEXT_REVALIDATE_SECRET) and Next.js
# (REVALIDATION_SECRET). The two MUST match. Generate a long random string.
REVALIDATION_SECRET=change_this_to_a_long_random_string

# Shared secret gating the view-counter write endpoint. The Next.js /api/views
# proxy sends it as a bearer token; WordPress (VIEWS_SECRET) validates it so the
# public /wp-json view-write endpoint can't be hit directly. Both MUST match.
VIEWS_SECRET=change_this_to_a_long_random_string

# ===========================================
# Nginx Configuration
# ===========================================
# Port to expose on host
NGINX_PORT=8080

# Domain name for production SSL — APEX only, no "www" (cert covers apex + www.apex)
DOMAIN=example.com

# SSL Email (for Let's Encrypt)
SSL_EMAIL=admin@example.com
